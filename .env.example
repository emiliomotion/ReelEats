# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic (Claude) — used for parsing
ANTHROPIC_API_KEY=your-anthropic-key

# OpenAI — used for Whisper transcription and GPT-4o vision OCR
OPENAI_API_KEY=your-openai-key

# Download microservice (Fly.io / self-hosted)
DOWNLOAD_SERVICE_URL=http://localhost:3001
DOWNLOAD_SERVICE_SECRET=your-download-service-secret
